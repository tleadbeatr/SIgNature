{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "signature",
  "main": "src/index.js",
  "compatibility_date": "2026-09-08",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "public",
    "binding": "ASSETS"
  }
  "analytics_engine_datasets": [
    {
      "binding": "SIGNATURE_LOG",
      "dataset": "signature_submissions"
    }
  ]
}
